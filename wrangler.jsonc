{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mzizi-api-gateway",
  // The Rust (workers-rs) Worker, the production api.mzizi.dev since the cutover
  // (mzizi-api#156). The TypeScript Worker it replaced is kept in wrangler.ts.jsonc,
  // for rollback and parity; see README "Cutover" and "Rollback".
  "main": "crates/mzizi-api-worker/build/index.js",
  "compatibility_date": "2026-05-22",
  "account_id": "125a2dfbc21f76a25c980609609e8218",

  // scripts/build-rust.sh does the whole build: the registry data (src/data/, bundled
  // into the wasm module), a Rust toolchain if the build image has none (rustup,
  // non-interactive), the wasm32 target, and worker-build 0.9.0. It is idempotent and
  // reads its toolchain version from rust-toolchain.toml. `wrangler dev` watches the
  // crate sources so an edit rebuilds.
  "build": {
    "command": "bash scripts/build-rust.sh",
    "watch_dir": ["crates/mzizi-api-worker/src", "crates/mzizi-api-types/src"],
  },

  // api.mzizi.dev is this Worker's custom domain. The owner moved it here from
  // the `mzizi-registry` Next.js Worker on 2026-09-29; declaring it here keeps
  // it under version control so every deploy reasserts it. Keep this exact
  // form — a BARE hostname, no `/*`, no `zone_name` (the three-field form
  // broke mzizi-mcp and the console).
  "routes": [{ "pattern": "api.mzizi.dev", "custom_domain": true }],
  "workers_dev": true,

  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
